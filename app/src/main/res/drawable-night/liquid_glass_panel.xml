<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 夜间深蓝玻璃卡片面板（与 DnaPalette 夜间根背景 #151B28/#212B3C 同色系，白字可读） -->
    <item android:top="3dp">
        <shape>
            <gradient android:angle="270" android:startColor="#33000000" android:endColor="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#B83A4355" android:centerColor="#8C313A48" android:endColor="#6628303E" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="16dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#26FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
