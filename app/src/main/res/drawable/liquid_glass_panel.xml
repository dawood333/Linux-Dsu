<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape>
            <gradient android:angle="270" android:startColor="#52000000" android:endColor="#18000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#f0ffffff" android:centerColor="#b8e8f0f5" android:endColor="#8fc2d0dc" />
            <stroke android:width="1dp" android:color="#d9ffffff" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="16dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00ffffff" android:centerColor="#70ffffff" android:endColor="#00ffffff" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
